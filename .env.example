# ==============================================================================
# Ink & Piercing SaaS CRM - Variáveis de Ambiente (Exemplo)
# Copie para .env antes de iniciar: cp .env.example .env
# ==============================================================================

# Ambiente: development | staging | production
APP_ENV=development
APP_NAME="Piercing & Tattoo Studio SaaS"
API_V1_PREFIX=/api/v1

# Banco de Dados (PostgreSQL 16+)
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=change_me_local_dev_password
POSTGRES_DB=crm_saas
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://crm_user:change_me_local_dev_password@db:5432/crm_saas

# Segurança & JWT (Gere em produção com: openssl rand -hex 32)
JWT_SECRET_KEY=dev_only_replace_with_64_char_random_hex_secret_key_0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
STUDIO_SELECTION_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies de Sessão (Refresh Token HttpOnly)
# Em ambiente local/celular via rede Wi-Fi HTTP mantenha false; em produção DEVE ser true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
REFRESH_COOKIE_NAME=crm_refresh_token

# CORS (origens separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Governança SaaS & Onboarding
ALLOW_PUBLIC_ONBOARDING=true
DEFAULT_TRIAL_DAYS=14
DEFAULT_TIMEZONE=America/Sao_Paulo

# Rate Limiting (requisições por janela em endpoints sensíveis de Auth)
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Seed Inicial de SuperAdmin (opcional - usado por `python -m app.cli seed-superadmin` ou startup)
AUTO_SEED_SUPERADMIN=true
SUPERADMIN_NAME="SaaS Platform Admin"
SUPERADMIN_EMAIL=admin@saas-studio.local
SUPERADMIN_PASSWORD=ChangeMeSuperAdmin!2026

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
